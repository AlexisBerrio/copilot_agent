# Copiar a .env (ignorado por git) y ajustar. Toda variable se valida al arrancar:
# una clave desconocida o un valor inválido impiden que el proceso arranque.

# Entorno de ejecución: local | test | ci | prod
ENVIRONMENT=local

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Obligatoria. URI de MongoDB. En local, el contenedor de docker-compose (puerto 27018, no 27017,
# para no chocar con un Mongo nativo). Puede contener credenciales: se trata como secreto.
MONGO_URI=mongodb://localhost:27018

# Nombre de la base de datos de la aplicación.
MONGO_DB_NAME=copilot
